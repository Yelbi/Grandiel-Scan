# ─────────────────────────────────────────────────────────────────────────────
# Grandiel Scan — variables de entorno
# Copia este archivo a `.env.local` para desarrollo.
# En producción se configuran en Vercel → Settings → Environment Variables.
# `.env.local` está en .gitignore: nunca subas valores reales al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Supabase Postgres, connection pooler) ─────────────────────
# Supabase → Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA con prefijo NEXT_PUBLIC_: da acceso total saltándose las RLS
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ────────────────────────────────────────────────────────────────────
# URL pública real. De aquí salen el sitemap, el robots.txt, las URLs canónicas
# y las previsualizaciones de redes sociales: si apunta a un dominio que no
# resuelve, Google no puede indexar y los enlaces compartidos salen rotos.
# Si se deja vacía en Vercel, se usa sola la URL de producción del proyecto.
NEXT_PUBLIC_SITE_URL=https://grandiel-scan-swart.vercel.app

# ── Panel de admin (/admin, Basic Auth en middleware.ts) ─────────────────────
ADMIN_PASSWORD=

# ── Crons (limpieza diaria + sincronización de capítulos) ────────────────────
# Protege /api/cron/cleanup y /api/cron/sync. Vercel envía
# `Authorization: Bearer $CRON_SECRET` en sus crons; GitHub Actions lo manda
# desde el secret del mismo nombre.
# OJO: sin esta variable los dos endpoints responden 401 SIEMPRE.
# Generar uno con:  openssl rand -hex 32
CRON_SECRET=

# ── Notificaciones push (VAPID) ──────────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Sentry ───────────────────────────────────────────────────────────────────
# DSN del proyecto: Sentry → Settings → Projects → [proyecto] → Client Keys (DSN).
# Se necesita la versión NEXT_PUBLIC_ para el navegador; el servidor acepta
# cualquiera de las dos.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Solo para el BUILD: suben los source maps para ver stack traces sin minificar.
# Si conectas Sentry desde el Marketplace de Vercel, estas tres las inyecta
# la integración y no hace falta escribirlas a mano.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Opcionales: fuerzan el envío de errores en desarrollo (por defecto solo en producción)
# NEXT_PUBLIC_SENTRY_DEBUG=true
# SENTRY_DEBUG=true
